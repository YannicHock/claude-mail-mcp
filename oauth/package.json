{
  "name": "claude-mail-mcp-oauth",
  "version": "0.7.0",
  "private": true,
  "description": "OAuth 2.1 authorization layer in front of the claude-mail-mcp connector — lets Claude's hosted surfaces (claude.ai web, Cowork) connect to a server that only speaks static Bearer auth.",
  "license": "MIT",
  "type": "module",
  "main": "dist/oauth/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/oauth/src/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:integration": "node --import tsx --test test/integration/*.test.ts",
    "hash-password": "node --import tsx src/hash-password.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
