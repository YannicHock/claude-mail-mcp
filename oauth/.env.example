# OAuth 2.1 layer for claude-mail-mcp — configuration.
#
# Every secret below can be given inline (NAME) or as a path to a file holding
# it (NAME_FILE). The deployment uses the file form, from the ./secrets bind
# mount docker-compose.yml sets up.
#
# A present file always wins. An absent one is *generated* — for
# UPSTREAM_AUTH_TOKEN, SIGNING_KEY and SETTINGS_SIGNING_KEY only, and written
# back to the NAME_FILE path so the next boot reads it rather than making a new
# one. An inline NAME with no file yet seeds the file instead of being replaced.
# A NAME_FILE that exists but cannot be read is still a startup error, never a
# silent fallback. AUTH_PASSWORD_HASH is never generated.

# ---- Required ------------------------------------------------------------

# Public HTTPS URL this service is reached at, without a trailing slash. This is
# the OAuth issuer and the base for every advertised endpoint, so it must be the
# address Claude actually connects to, not the internal one.
#
# The hostname needs an A record: Claude connectors are IPv4-only, and a name
# that only publishes AAAA records cannot be reached at all.
PUBLIC_URL=https://mcp-mail.example.com

# The connector's AUTH_TOKEN — the same file the connector reads as its own
# AUTH_TOKEN_FILE. Substituted into every proxied request and never sent to a
# client. Generated on the first boot that finds the file absent.
UPSTREAM_AUTH_TOKEN_FILE=/secrets/auth_token.txt

# Signs access tokens, refresh tokens and the sign-in form's request token.
# At least 32 bytes. Generated on the first boot that finds the file absent;
# supply your own with `openssl rand -base64 48 > secrets/oauth_signing_key.txt`
# if you would rather.
#
# Keep it: regenerating logs every connected client out, and makes a rotation
# indistinguishable from a refresh-token replay in the logs. This is why the
# generated value is written to the file rather than held for one process.
SIGNING_KEY_FILE=/secrets/oauth_signing_key.txt

# scrypt hash of the operator's password. Generate with:
#
#   read -rs PW && printf '%s\n' "$PW" | docker compose run --rm -T \
#     --entrypoint node mail-oauth dist/hash-password.js \
#     > secrets/auth_password_hash.txt; unset PW
#
# The --entrypoint override is required: the image's ENTRYPOINT is
# `node dist/index.js`, so a trailing `node dist/hash-password.js` is appended
# to it as arguments and starts the server instead. `read -rs` keeps the
# password off the terminal and out of shell history.
#
# Only *seeds* the operator record in OPERATOR_FILE below, on that file's
# first creation — it is not read again afterwards. Changing this secret once
# OPERATOR_FILE exists has no effect on the live password; change the password
# through the settings UI instead. The service warns by name at startup when
# this hash and the stored one differ, so a stale secret does not fail silently.
AUTH_PASSWORD_HASH_FILE=/secrets/auth_password_hash.txt

# ---- Optional ------------------------------------------------------------

# Where to forward authenticated MCP traffic. Default suits docker-compose.yml.
UPSTREAM_MCP_URL=http://mail-mcp:3220

# Username for the sign-in form.
AUTH_USERNAME=operator

# Path component the MCP endpoint is served at. The connector URL entered in
# Claude is PUBLIC_URL + MCP_PATH, and the advertised `resource` must match it
# exactly, path included.
MCP_PATH=/mcp

# Listener. Left alone under docker-compose.yml.
PORT=8080
HOST=0.0.0.0

# Number of reverse-proxy hops in front of this service. Decides which
# X-Forwarded-For entry becomes the client address the login throttle buckets on
# and the fail2ban log line names.
#
# 1 is correct for a single TLS-terminating proxy (nginx, Nginx Proxy Manager,
# Caddy, Traefik). Raise it only if there is genuinely another trusted hop, such
# as a CDN — setting it higher than the real chain lets a client forge its own
# address again, which is exactly what the throttle exists to prevent. Use 0 if
# nothing proxies this service.
TRUST_PROXY=1

# Registered clients and live refresh sessions. Set to "none" to keep state in
# memory only, which logs every client out on restart.
STATE_FILE=/data/oauth-state.json

# Shared key that lets the connector trust a /settings/mailboxes request as
# having genuinely come through this service's session and CSRF checks,
# rather than directly from the network. At least 32 bytes, generated on the
# first boot that finds the file absent.
#
# The connector needs the *same* file (its own SETTINGS_SIGNING_KEY_FILE), which
# docker-compose.yml already points at this path.
# Without it set on both sides, the settings UI is simply unavailable — the
# connector refuses /settings/* outright, and this service's own /settings
# pages (sign-in, client list, password change) still work.
SETTINGS_SIGNING_KEY_FILE=/secrets/settings_signing_key.txt

# Where the live operator record — username, password hash, session epoch —
# is stored, seeded on first start from AUTH_PASSWORD_HASH(_FILE) above. Once
# this file exists, it is the only thing that matters for sign-in; the secret
# is not read again. Defaults to operator.json next to STATE_FILE. Set to
# "none" to keep today's behaviour: hash from the secret only, and the
# settings UI's password-change form disabled.
OPERATOR_FILE=/data/operator.json

# Token lifetimes in seconds. Claude refreshes proactively five minutes before
# expiry, so a short access token costs nothing.
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000

# Claude's two hosted callbacks are always accepted. Loopback redirects are for
# Claude Code, which does not need this service — it can use the connector's
# static token directly — so they stay off unless you want them.
ALLOW_LOOPBACK_REDIRECT=false

# Additional redirect URIs, comma separated. Each must be https, or http on a
# loopback address.
# EXTRA_REDIRECT_URIS=

LOG_LEVEL=info
