# OAuth 2.1 layer for claude-mail-mcp — configuration.
#
# Every secret below can be given inline (NAME) or as a path to a file holding
# it (NAME_FILE). The deployment uses the file form via Docker secrets; NAME_FILE
# wins when both are set, and an unreadable NAME_FILE is a startup error rather
# than a silent fallback.

# ---- Required ------------------------------------------------------------

# Public HTTPS URL this service is reached at, without a trailing slash. This is
# the OAuth issuer and the base for every advertised endpoint, so it must be the
# address Claude actually connects to, not the internal one.
#
# The hostname needs an A record: Claude connectors are IPv4-only, and a name
# that only publishes AAAA records cannot be reached at all.
PUBLIC_URL=https://mail-mcp.example.com

# The connector's AUTH_TOKEN. Substituted into every proxied request and never
# sent to a client.
UPSTREAM_AUTH_TOKEN_FILE=/run/secrets/auth_token

# Signs access tokens, refresh tokens and the sign-in form's request token.
# At least 32 bytes. Generate with: openssl rand -base64 48
#
# Keep it: regenerating logs every connected client out, and makes a rotation
# indistinguishable from a refresh-token replay in the logs.
SIGNING_KEY_FILE=/run/secrets/oauth_signing_key

# scrypt hash of the operator's password. Generate with:
#   docker compose run --rm --no-TTY mail-oauth node dist/hash-password.js \
#     > secrets/auth_password_hash.txt
AUTH_PASSWORD_HASH_FILE=/run/secrets/auth_password_hash

# ---- Optional ------------------------------------------------------------

# Where to forward authenticated MCP traffic. Default suits docker-compose.yml.
UPSTREAM_MCP_URL=http://mail-mcp:3220

# Username for the sign-in form.
AUTH_USERNAME=operator

# Path component the MCP endpoint is served at. The connector URL entered in
# Claude is PUBLIC_URL + MCP_PATH, and the advertised `resource` must match it
# exactly, path included.
MCP_PATH=/mcp

# Listener. Left alone under docker-compose.yml.
PORT=8080
HOST=0.0.0.0

# Registered clients and live refresh sessions. Set to "none" to keep state in
# memory only, which logs every client out on restart.
STATE_FILE=/data/oauth-state.json

# Token lifetimes in seconds. Claude refreshes proactively five minutes before
# expiry, so a short access token costs nothing.
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000

# Claude's two hosted callbacks are always accepted. Loopback redirects are for
# Claude Code, which does not need this service — it can use the connector's
# static token directly — so they stay off unless you want them.
ALLOW_LOOPBACK_REDIRECT=false

# Additional redirect URIs, comma separated. Each must be https, or http on a
# loopback address.
# EXTRA_REDIRECT_URIS=

LOG_LEVEL=info
