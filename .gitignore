node_modules/
dist/
.env
.env.local
# Same reasoning as .env: docker-compose.yml reads this one for the OAuth
# layer, and docs/DEPLOYMENT.md tells operators to create it in the checkout.
.env.oauth
*.log
.DS_Store
.idea/
.vscode/
coverage/
*.tsbuildinfo

# Mailbox credentials — accounts.json holds plaintext IMAP/SMTP/CalDAV
# passwords. README.md and docs/DEPLOYMENT.md both tell operators to create
# it *inside* a git checkout (repo root for local dev, ./data for the Docker
# deployment), so both locations are ignored here. Already in .dockerignore.
accounts.json
data/

# OAuth layer secrets — the connector's AUTH_TOKEN, the token signing key and
# the operator's password hash, mounted as Docker file-secrets. Anything under
# secrets/ is a credential by definition; committing one would hand over the
# mailboxes as surely as accounts.json would.
secrets/

# Registered OAuth clients and live refresh sessions. Not secret, but it is
# per-deployment runtime state and belongs on the host, not in the repository.
oauth-data/
