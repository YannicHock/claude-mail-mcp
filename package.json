{
  "name": "claude-mail-mcp",
  "version": "0.5.0",
  "description": "Self-hosted IMAP/SMTP/CalDAV connector for Claude — Streamable HTTP MCP server. Read+write email and calendar against any RFC-compliant mailbox (Mailbox.org, Fastmail, iCloud, Mailcow, iRedMail, Migadu, Nextcloud, …).",
  "license": "MIT",
  "author": "Markus Stöger <hi@markusstoeger.com> (https://markusstoeger.com)",
  "homepage": "https://github.com/YannicHock/claude-mail-mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/YannicHock/claude-mail-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/YannicHock/claude-mail-mcp/issues"
  },
  "keywords": [
    "claude",
    "anthropic",
    "mcp",
    "model-context-protocol",
    "imap",
    "smtp",
    "caldav",
    "email",
    "calendar",
    "self-hosted",
    "connector"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "claude-mail-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/integration/*.test.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "ical.js": "^2.2.1",
    "imapflow": "^2.0.0",
    "mailparser": "^3.9.23",
    "nodemailer": "^10.0.1",
    "tsdav": "^2.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
