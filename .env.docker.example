# claude-mail-mcp v0.2 — docker-compose environment file.
# Copy to .env next to docker-compose.yml: cp .env.docker.example .env
# Mailbox credentials (IMAP, SMTP, CalDAV) are stored in accounts.json,
# mounted into the container at /data/accounts.json. You create that file by
# hand — see docs/DEPLOYMENT.md, "Container deployment" step 3, or through the
# settings UI once mail-oauth is running (see oauth/.env.example).

# --- Shared secrets group ---
# The gid of the host group that owns ./secrets. Both containers are put in it
# (docker-compose.yml, `group_add`) so each can read a secret the other wrote;
# without it `docker compose up` refuses to start.
#
# Create a group for this and nothing else, then read its real gid back:
#
#   sudo groupadd --system mailsecrets
#   mkdir -p secrets
#   sudo chgrp mailsecrets secrets && sudo chmod 2770 secrets
#   getent group mailsecrets | cut -d: -f3
#
# Do not substitute a group that already exists on the host. `2770` is group
# rwx, and directory write permission is what allows unlink — every member of
# whatever group owns this directory can replace auth_token.txt, and "a present
# file wins" then makes the replacement authoritative for both services. Earlier
# versions of this deployment named gid 105 outright, which on Debian and Ubuntu
# is inside the system range and usually already taken; that is the bug this
# variable exists to remove.
#
# This value is read by Compose from this file — it must be .env next to
# docker-compose.yml, which is the file Compose interpolates.
SECRETS_GID=

# --- Server ---
# HOST and PORT are fixed by the image (0.0.0.0:3220) and not set here.
# docker-compose publishes the container on 127.0.0.1:3220 on the host;
# nginx/Caddy terminates TLS upstream — see docs/DEPLOYMENT.md.
# If you run the mail-oauth service, this MUST be the exact same value as
# PUBLIC_URL in .env.oauth. It is the `iss` this process checks on every
# settings-assertion header mail-oauth sends; a mismatch fails that check
# silently and every /settings/mailboxes request 401s with no other signal.
PUBLIC_URL=https://mcp-mail.example.com
# debug | info | warn | error
LOG_LEVEL=info

# --- Authentication ---
# Bearer token clients must send in `Authorization: Bearer <token>` to call /mcp.
# This is the only thing gating /mcp. Claude Desktop (and any MCP client that
# lets you set a custom header) sends it directly.
#
# Leave it empty and it is generated on first boot into
# secrets/auth_token.txt — the same file the mail-oauth service reads as its
# UPSTREAM_AUTH_TOKEN, so the two always agree. Read it back with:
#
#   cat secrets/auth_token.txt
#
# Set it here instead and that value is used and written to the same file, so an
# existing install keeps the token its Claude clients already have. Either way
# the file wins once it exists: editing this line afterwards does nothing.
AUTH_TOKEN=

# --- Accounts ---
# ACCOUNTS_FILE is fixed to /data/accounts.json by docker-compose.yml
# (bind-mounted, writable, from the host's ./data — the settings UI, when
# enabled below, saves to it). Not set here.

# --- Settings UI ---
# Shared key with the mail-oauth service's SETTINGS_SIGNING_KEY_FILE. Lets
# this container trust a /settings/mailboxes request as having genuinely come
# through mail-oauth's session and CSRF checks. Fixed by docker-compose.yml to
# secrets/settings_signing_key.txt and generated there on first boot, so the
# settings UI works out of the box. Not set here.
