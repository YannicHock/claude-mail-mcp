{
  // Typecheck-only project for the test suite.
  //
  // tsconfig.json's `include` is ["src/**/*", "shared/**/*"], so `tsc --noEmit`
  // compiles zero files under test/ — confirmed with `tsc --noEmit --listFiles`.
  // The tests are run with `node --import tsx`, and tsx *strips* types without
  // checking them, so before this file nothing anywhere typechecked the test
  // suite.
  //
  // It stays a separate project rather than a widened `include` in
  // tsconfig.json because that file is also the build: `npm run build` (and the
  // Dockerfile's builder stage) emits from it into dist/, and pulling test/ in
  // would emit dist/test/… into the image alongside the code.
  //
  // Run with: npm run typecheck:test
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*", "shared/**/*", "test/**/*"],
  // Load-bearing, despite looking byte-identical to the parent's and therefore
  // removable. `exclude` is not merged across `extends`: it comes from whichever
  // config declares it last, so this line is what stops a future `"test"` entry
  // in tsconfig.json's exclude from cancelling the `test/**/*` above. Delete it,
  // or add `"test"` there, and this project typechecks *nothing* — silently, and
  // green, because `npm run typecheck:test` reports success over an empty file
  // list and `tsx` strips types at runtime without checking them.
  //
  // Verify with `tsc -p tsconfig.test.json --listFiles`: the connector's test
  // files must appear in it. oauth/tsconfig.test.json carries the same line for
  // the same reason, and there the trap was not hypothetical — see its comment.
  "exclude": ["node_modules", "dist"]
}
