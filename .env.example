# claude-mail-mcp v0.2 — only transport-level config lives here.
# Mailbox credentials (IMAP, SMTP, CalDAV) are stored in accounts.json,
# which you create by hand — see docs/DEPLOYMENT.md step 3, "Writing
# accounts.json by hand".

# --- Server ---
# Interface to bind on. Default 127.0.0.1 (loopback only). nginx/Caddy
# terminates TLS upstream. Set to 0.0.0.0 only if you really want this
# process directly internet-reachable.
HOST=127.0.0.1
PORT=3220
# If you run the OAuth layer (oauth/.env.example), this MUST be the exact
# same value as PUBLIC_URL there. It is the `iss` this process checks on every
# settings-assertion header the OAuth layer sends; a mismatch fails that check
# silently and every /settings/mailboxes request 401s with no other signal.
PUBLIC_URL=https://mcp-mail.example.com
# debug | info | warn | error
LOG_LEVEL=info

# --- Authentication ---
# Bearer token clients must send in `Authorization: Bearer <token>` to call /mcp.
# This is the only thing gating /mcp. Claude Desktop (and any MCP client that
# lets you set a custom header) sends it directly.
#
# Set this, or AUTH_TOKEN_FILE — with neither the server refuses to start.
# AUTH_TOKEN_FILE is the file form: a present file wins, and an absent one is
# generated on first boot and written back to that path. Generating needs a path
# to write to, so on this path a value here is the only way in.
# Generate with: openssl rand -hex 32
AUTH_TOKEN=

# --- Accounts ---
# Path to the multi-account credentials file (IMAP/SMTP/CalDAV passwords).
# Create it by hand — see docs/DEPLOYMENT.md step 3, "Writing accounts.json by
# hand". The backend re-reads the file via fs.watch, so adding or rotating an
# account applies without a restart.
# A missing file is not an error; it means "no accounts configured yet".
#
# This default is the state directory of the systemd deployment SECURITY.md
# still describes, owned by the `mailmcp` service user at mode 600.
# docs/DEPLOYMENT.md no longer documents that deployment — see "Running from
# source" — so nothing in this repository creates the directory for you. The
# docker-compose deployment overrides this to /data/accounts.json (bind-mounted
# from ./data).
# For local development, point it at a file in your own checkout or home dir,
# e.g. ACCOUNTS_FILE=./accounts.json (already git-ignored).
ACCOUNTS_FILE=/var/lib/mail-mcp/accounts.json

# --- Settings UI ---
# Shared key with the OAuth layer's SETTINGS_SIGNING_KEY_FILE. Lets this
# process trust a /settings/mailboxes request as having genuinely come through
# the OAuth layer's session and CSRF checks. At least 32 bytes.
# Generate with: openssl rand -base64 48
# Leave unset to keep /settings/mailboxes disabled and this process behaving
# exactly as it does without the OAuth layer.
SETTINGS_SIGNING_KEY_FILE=

# Number of reverse-proxy hops in front of this service. Decides which
# X-Forwarded-For entry becomes the client address, which is the value the
# rejected-request log line names — the field a fail2ban jail would match.
#
# A count, never `true`: trusting the whole chain takes its leftmost entry,
# and that entry is written by the client. 1 is correct for a single
# TLS-terminating proxy. The mail-oauth service in between costs no hop — its
# proxy forwards X-Forwarded-For unchanged rather than appending to it. Use 0
# if nothing proxies this service.
TRUST_PROXY=1
